{
  "name": "@field-reporting/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @field-reporting/types build && nest build",
    "start": "node dist/main.js",
    "start:dev": "pnpm --filter @field-reporting/types build && nest start --watch",
    "pretest": "pnpm --filter @field-reporting/types build",
    "test": "prisma migrate deploy && jest --config ./test/jest-e2e.json --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "prisma migrate deploy && jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@field-reporting/types": "workspace:*",
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.5.0",
    "multer": "^1.4.5-lts.2",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.20",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.7.3"
  }
}
